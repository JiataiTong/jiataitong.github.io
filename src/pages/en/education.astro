---
import BaseLayout from "@layouts/BaseLayout.astro";
import EducationList from "@components/EducationList.astro";
import { getCollection } from "astro:content";
import type { Lang } from "@i18n/ui";

const locale = (Astro.currentLocale ?? "en") as Lang;
const education = await getCollection("education");
const coursework = await getCollection("coursework");
---

<BaseLayout title="Education">
    <h1 class="mb-6 text-3xl font-bold">Education</h1>
    <EducationList items={education} coursework={coursework} locale={locale} />
</BaseLayout>
